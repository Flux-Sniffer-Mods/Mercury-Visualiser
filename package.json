{
  "name": "mercury-visualiser",
  "version": "1.6.1",
  "description": "Makes the Obsidian Graph view easier to read: automatic tag colours, evenly spread links, pie-chart dots, line labels and smoother big graphs.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "graph",
    "tags"
  ],
  "author": "Flux Sniffer Mods",
  "license": "MIT",
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.8.7",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "monkey-around": "^3.0.0"
  }
}
